# Gemini API Key (server-only, used for YouTube video & catalog song chord extraction)
GEMINI_API_KEY=

# Optional Spotify Web API Credentials (server-only, falls back to iTunes Search API if unset)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Firebase Web SDK Configuration (client-accessible)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
